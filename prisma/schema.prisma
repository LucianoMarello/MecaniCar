// Después de cualquier cambio en este archivo:
//   npx prisma migrate dev --name <descripcion-del-cambio>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Vercel es serverless, así que hacen falta dos conexiones distintas:
  //   DATABASE_URL → el pooler, que la app usa en cada request
  //   DIRECT_URL   → la conexión directa, que usan las migraciones
  // Con una sola funciona en clase y se cae en producción por agotar
  // las conexiones de Postgres.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  CLIENTE
  MECANICO
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

enum EstadoOrdenTrabajo {
  ABIERTA
  EN_REPARACION
  FINALIZADA
}

enum EstadoPresupuesto {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nombre    String
  apellido  String
  rol       Rol
  creadoEn  DateTime @default(now())
  telefono  String
  direccion String

  vehiculos Vehiculo[]
  turnos    Turno[]
}

model Vehiculo {
  id          String   @id @default(cuid())
  patente     String   @unique
  marca       String
  modelo      String
  anio        Int

  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  turnos      Turno[]
  ordenes     OrdenTrabajo[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([usuarioId])
}

model Turno {
  id          String          @id @default(cuid())

  usuarioId   String
  usuario     Usuario      @relation(fields: [usuarioId], references: [id])

  vehiculoId  String
  vehiculo    Vehiculo     @relation(fields: [vehiculoId], references: [id])

  fechaHora   DateTime
  motivo      String
  estado      EstadoTurno @default(PENDIENTE)

  fechaCreacion DateTime   @default(now())

  ordenTrabajo OrdenTrabajo?

  @@index([usuarioId])
  @@index([vehiculoId])
}

model OrdenTrabajo {
  id             String                 @id @default(cuid())

  turnoId        String                 @unique
  turno          Turno               @relation(fields: [turnoId], references: [id])

  vehiculoId     String
  vehiculo       Vehiculo            @relation(fields: [vehiculoId], references: [id])

  fechaIngreso   DateTime
  estado         EstadoOrdenTrabajo  @default(ABIERTA)

  fechaCreacion  DateTime            @default(now())

  presupuestos   Presupuesto[]

  @@index([vehiculoId])
}

model Servicio {
  id          String      @id @default(cuid())
  nombre      String
  descripcion String?
  precioActual Decimal

  detalles    DetallePresupuesto[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Presupuesto {
  id              String                 @id @default(cuid())

  ordenTrabajoId  String
  ordenTrabajo    OrdenTrabajo        @relation(fields: [ordenTrabajoId], references: [id])

  estado          EstadoPresupuesto   @default(PENDIENTE)

  fechaCreacion   DateTime            @default(now())

  detalles        DetallePresupuesto[]
}

model DetallePresupuesto {
  id              String         @id @default(cuid())

  presupuestoId   String
  presupuesto     Presupuesto @relation(fields: [presupuestoId], references: [id])

  servicioId      String
  servicio        Servicio    @relation(fields: [servicioId], references: [id])

  precioAplicado  Decimal

  @@unique([presupuestoId, servicioId])
}