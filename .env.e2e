# Las variables de las pruebas de punta a punta (`npm run test:e2e`).
#
# Este archivo SÍ se commitea, y es a propósito: no tiene un solo secreto.
# Todo apunta a una base local que se puede llenar de datos de prueba, y el
# AUTH_SECRET de acá no firma ninguna sesión de verdad.
#
# Tiene que definir TODAS las variables de .env.example, aunque sea vacías:
# `prisma.config.ts` y `next start` completan con .env.local (producción) lo
# que falte. `playwright.config.ts` frena si las bases no son locales o si la
# clave de Resend no está vacía.
#
# La base se crea una sola vez, con el mismo usuario en todas las máquinas y
# en el CI (ver la sección Pruebas del README).
DATABASE_URL="postgresql://e2e:e2e@localhost:5432/mecanicar_e2e"
DIRECT_URL="postgresql://e2e:e2e@localhost:5432/mecanicar_e2e"

AUTH_SECRET="secreto-de-las-pruebas-e2e-no-sirve-para-nada-mas"
# `next start` fuera de Vercel no confía en el host si no se lo dice.
AUTH_TRUST_HOST="true"
# Google no se usa: las pruebas fabrican la cookie de sesión (e2e/preparar.ts).
AUTH_GOOGLE_ID="e2e"
AUTH_GOOGLE_SECRET="e2e"

# El administrador que crea el seed. Sin esta línea, el seed tomaría el
# correo real de .env.local.
BOOTSTRAP_ADMIN_EMAIL="admin@ejemplo.com"

# Vacías a propósito: las pruebas no mandan correos. La app guarda la
# operación igual y le muestra al taller el aviso pendiente (spec 9.3 y 9.4).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_TEST_RECIPIENT=""

# Que el aviso de versión nueva de Prisma no ensucie la salida de las pruebas.
PRISMA_HIDE_UPDATE_MESSAGE="1"
